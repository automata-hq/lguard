{
  "name": "lguard",
  "version": "0.4.0",
  "description": "Scan dependencies for open source license risks across npm, cargo, pip, gems, go, and swift",
  "type": "module",
  "bin": {
    "lguard": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "license",
    "audit",
    "compliance",
    "dependencies",
    "security",
    "copyleft",
    "agpl",
    "gpl",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automata-hq/lguard.git"
  },
  "homepage": "https://github.com/automata-hq/lguard",
  "bugs": "https://github.com/automata-hq/lguard/issues",
  "author": "automata-hq",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
